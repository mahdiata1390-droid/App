<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="6dp" android:top="6dp">
        <shape><solid android:color="#020914"/><corners android:radius="28dp"/></shape>
    </item>
    <item android:right="6dp" android:bottom="6dp">
        <shape><solid android:color="#16446A"/><corners android:radius="28dp"/></shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape>
            <gradient android:angle="135" android:startColor="#12314D" android:centerColor="#0B1D32" android:endColor="#071321"/>
            <corners android:radius="28dp"/>
            <stroke android:width="1dp" android:color="#20BFFF"/>
        </shape>
    </item>
</layer-list>