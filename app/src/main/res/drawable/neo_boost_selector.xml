<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:left="3dp" android:top="3dp">
                <shape><solid android:color="#020812"/><corners android:radius="28dp"/></shape>
            </item>
            <item android:right="3dp" android:bottom="3dp">
                <shape><solid android:color="#2495E6"/><corners android:radius="28dp"/></shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape><solid android:color="#10365A"/><stroke android:width="2dp" android:color="#59D8FF"/><corners android:radius="28dp"/></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="6dp" android:top="6dp">
                <shape><solid android:color="#020812"/><corners android:radius="28dp"/></shape>
            </item>
            <item android:right="6dp" android:bottom="6dp">
                <shape><solid android:color="#1769A8"/><corners android:radius="28dp"/></shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape><solid android:color="#0B2340"/><stroke android:width="2dp" android:color="#19B5FF"/><corners android:radius="28dp"/></shape>
            </item>
        </layer-list>
    </item>
</selector>