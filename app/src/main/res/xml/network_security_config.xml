<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The app only needs an outbound TLS ping for the latency card: no cleartext at all. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
