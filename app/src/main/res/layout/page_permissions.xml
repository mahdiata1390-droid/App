<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/permissionPage"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/permissionsBack"
                style="@style/GbIconButton"
                android:contentDescription="@string/settings"
                android:src="@drawable/ic_back"
                android:tint="@color/gb_text" />

            <TextView
                style="@style/GbTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/permission_center" />

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_settings"
                android:tint="@color/gb_muted" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="236dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:tag="glass"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <FrameLayout
                android:layout_width="104dp"
                android:layout_height="104dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_glow" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/permission_center"
                    android:padding="16dp"
                    android:src="@drawable/ic_shield"
                    android:tint="?attr/gbAccentBright" />
            </FrameLayout>

            <TextView
                android:id="@+id/permissionHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/perm_some_title"
                android:textColor="@color/gb_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/permissionSubline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/perm_some_sub"
                android:textColor="@color/gb_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/permissionUsageRow"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_soft"
            android:tag="glass"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_circle"
                android:contentDescription="@null"
                android:padding="9dp"
                android:src="@drawable/ic_speed"
                android:tint="?attr/gbAccentBright" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/GbRowTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_usage" />

                <TextView
                    style="@style/GbRowSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_usage_sub" />
            </LinearLayout>

            <TextView
                android:id="@+id/permissionUsageStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grant"
                android:textColor="?attr/gbAccentBright"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/permissionNotificationRow"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_soft"
            android:tag="glass"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_circle"
                android:contentDescription="@null"
                android:padding="9dp"
                android:src="@drawable/ic_bell"
                android:tint="?attr/gbAccentBright" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/GbRowTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_notifications" />

                <TextView
                    style="@style/GbRowSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_notifications_sub" />
            </LinearLayout>

            <TextView
                android:id="@+id/permissionNotificationStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grant"
                android:textColor="?attr/gbAccentBright"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/permissionBatteryRow"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_soft"
            android:tag="glass"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_circle"
                android:contentDescription="@null"
                android:padding="9dp"
                android:src="@drawable/ic_battery"
                android:tint="@color/gb_green" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/GbRowTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_battery" />

                <TextView
                    style="@style/GbRowSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_battery_sub" />
            </LinearLayout>

            <TextView
                android:id="@+id/permissionBatteryStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grant"
                android:textColor="?attr/gbAccentBright"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/permissionOverlayRow"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_soft"
            android:tag="glass"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_circle"
                android:contentDescription="@null"
                android:padding="9dp"
                android:src="@drawable/ic_layers"
                android:tint="?attr/gbAccentBright" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/GbRowTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_overlay" />

                <TextView
                    style="@style/GbRowSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_overlay_sub" />
            </LinearLayout>

            <TextView
                android:id="@+id/permissionOverlayStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grant"
                android:textColor="?attr/gbAccentBright"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/permissionSettingsRow"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_soft"
            android:tag="glass"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_circle"
                android:contentDescription="@null"
                android:padding="9dp"
                android:src="@drawable/ic_settings"
                android:tint="?attr/gbAccentBright" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/GbRowTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_settings" />

                <TextView
                    style="@style/GbRowSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_settings_sub" />
            </LinearLayout>

            <TextView
                android:id="@+id/permissionSettingsStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grant"
                android:textColor="?attr/gbAccentBright"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/permissionDndRow"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_soft"
            android:tag="glass"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_circle"
                android:contentDescription="@null"
                android:padding="9dp"
                android:src="@drawable/ic_bell"
                android:tint="@color/gb_gold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/GbRowTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_dnd" />

                <TextView
                    style="@style/GbRowSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_dnd_sub" />
            </LinearLayout>

            <TextView
                android:id="@+id/permissionDndStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grant"
                android:textColor="?attr/gbAccentBright"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/permissionsDone"
            style="@style/GbPrimaryButton"
            android:layout_width="match_parent"
            android:layout_marginTop="16dp"
            android:text="@string/great" />
    </LinearLayout>
</ScrollView>
