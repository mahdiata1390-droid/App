<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/electric_background">

    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginBottom="78dp">

        <ScrollView android:id="@+id/homePage" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <ImageView android:id="@+id/lightningIcon" android:layout_width="38dp" android:layout_height="38dp" android:src="@drawable/ic_lightning" android:contentDescription="Game Booster"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Game Booster" android:textColor="@color/gb_text" android:textSize="25sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/homePremium" android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:text="♛" android:textColor="#FFE36B" android:textSize="23sp" android:background="@drawable/neo_icon"/>
                </LinearLayout>
                <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:padding="11dp" android:gravity="center" android:text="SYSTEM READY • SELECT A GAME" android:textColor="@color/gb_muted" android:textSize="10sp" android:textStyle="bold" android:background="@drawable/electric_status"/>
                <FrameLayout android:layout_width="match_parent" android:layout_height="270dp" android:layout_marginTop="12dp">
                    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/boost_ring"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                        <ImageView android:layout_width="62dp" android:layout_height="62dp" android:src="@drawable/ic_game_booster" android:contentDescription="Boost"/>
                        <TextView android:id="@+id/boost" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Boost" android:textColor="@color/gb_text" android:textSize="28sp" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tap to Boost" android:textColor="@color/gb_accent_bright" android:textSize="11sp"/>
                    </LinearLayout>
                </FrameLayout>
                <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:rowCount="2" android:useDefaultMargins="false">
                    <TextView android:id="@+id/ram" android:layout_width="0dp" android:layout_height="86dp" android:layout_columnWeight="1" android:layout_margin="5dp" android:gravity="center" android:text="RAM&#10;--" android:textColor="@color/gb_text" android:background="@drawable/neo_card"/>
                    <TextView android:id="@+id/battery" android:layout_width="0dp" android:layout_height="86dp" android:layout_columnWeight="1" android:layout_margin="5dp" android:gravity="center" android:text="BATTERY&#10;--" android:textColor="@color/gb_text" android:background="@drawable/neo_card"/>
                    <TextView android:id="@+id/thermal" android:layout_width="0dp" android:layout_height="86dp" android:layout_columnWeight="1" android:layout_margin="5dp" android:gravity="center" android:text="TEMP&#10;--" android:textColor="@color/gb_text" android:background="@drawable/neo_card"/>
                    <TextView android:id="@+id/networkStatus" android:layout_width="0dp" android:layout_height="86dp" android:layout_columnWeight="1" android:layout_margin="5dp" android:gravity="center" android:text="NETWORK&#10;--" android:textColor="@color/gb_text" android:background="@drawable/neo_card"/>
                </GridLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
                    <TextView android:id="@+id/pingStatus" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_margin="5dp" android:gravity="center" android:text="PING&#10;--" android:textColor="@color/gb_text" android:background="@drawable/neo_card"/>
                    <TextView android:id="@+id/refresh" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_margin="5dp" android:gravity="center" android:text="DISPLAY&#10;--" android:textColor="@color/gb_text" android:background="@drawable/neo_card"/>
                    <TextView android:id="@+id/sessionTimer" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_margin="5dp" android:gravity="center" android:text="SESSION&#10;00:00:00" android:textColor="@color/gb_text" android:background="@drawable/neo_card"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ScrollView android:id="@+id/gamesPage" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🎮  Game Library" android:textColor="@color/gb_text" android:textSize="24sp" android:textStyle="bold"/>
                    <Button android:id="@+id/refreshStats" android:layout_width="58dp" android:layout_height="48dp" android:text="↻" android:textColor="@color/gb_accent_bright" android:background="@drawable/neo_button"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:gravity="center" android:text="All" android:textColor="@color/gb_text" android:background="@drawable/neo_selected"/>
                    <TextView android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:gravity="center" android:text="Popular" android:textColor="@color/gb_muted"/>
                    <TextView android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:gravity="center" android:text="Installed" android:textColor="@color/gb_muted"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/games" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="14dp"/>
            </LinearLayout>
        </ScrollView>

        <ScrollView android:id="@+id/boostingPage" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:padding="20dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <Button android:id="@+id/boostBack" android:layout_width="52dp" android:layout_height="48dp" android:text="‹" android:textSize="28sp" android:textColor="@color/gb_text" android:background="@drawable/neo_button"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Boosting..." android:textColor="@color/gb_text" android:textSize="22sp" android:textStyle="bold"/>
                    <TextView android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="⚙" android:textColor="@color/gb_accent_bright" android:background="@drawable/neo_icon"/>
                </LinearLayout>
                <FrameLayout android:layout_width="290dp" android:layout_height="290dp" android:layout_marginTop="35dp">
                    <ProgressBar android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateTint="@color/gb_accent"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                        <ImageView android:layout_width="70dp" android:layout_height="70dp" android:src="@drawable/ic_game_booster" android:contentDescription="Boosting"/>
                        <TextView android:id="@+id/boostProgress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="82%" android:textColor="@color/gb_text" android:textSize="36sp" android:textStyle="bold"/>
                    </LinearLayout>
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Optimizing your device..." android:textColor="@color/gb_muted" android:textSize="14sp"/>
                <TextView android:id="@+id/boostSteps" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:padding="18dp" android:text="✓ Cleaning background apps...&#10;&#10;✓ Freeing up RAM...&#10;&#10;✓ Optimizing performance...&#10;&#10;✓ Cooling CPU..." android:textColor="@color/gb_text" android:textSize="14sp" android:background="@drawable/neo_card"/>
                <Button android:id="@+id/endBoost" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="18dp" android:text="END SESSION" android:textColor="@color/gb_accent_bright" android:background="@drawable/neo_button"/>
            </LinearLayout>
        </ScrollView>

        <ScrollView android:id="@+id/settingsPage" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚙  Settings" android:textColor="@color/gb_text" android:textSize="25sp" android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:padding="18dp" android:text="GAME BOOSTER&#10;Premium Performance" android:textColor="@color/gb_text" android:textSize="17sp" android:textStyle="bold" android:background="@drawable/neo_card"/>
                <Button android:id="@+id/dnd" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="14dp" android:text="⚙  Boost Mode • Performance / Balanced / Battery" android:textColor="@color/gb_text" android:background="@drawable/neo_button"/>
                <Button android:id="@+id/appearanceButton" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="10dp" android:text="◐  Appearance • Dark / AMOLED" android:textColor="@color/gb_text" android:background="@drawable/neo_button"/>
                <Button android:id="@+id/languageButton" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="10dp" android:text="◎  Language • English / فارسی" android:textColor="@color/gb_text" android:background="@drawable/neo_button"/>
                <Button android:id="@+id/permissionButton" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="10dp" android:text="🛡  Permission Center" android:textColor="@color/gb_accent_bright" android:background="@drawable/neo_button"/>
            </LinearLayout>
        </ScrollView>

        <ScrollView android:id="@+id/permissionPage" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🛡  Permission Center" android:textColor="@color/gb_text" android:textSize="24sp" android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="✓  All Permissions Granted&#10;Your device is fully optimized!" android:textColor="@color/gb_accent_bright" android:textSize="16sp" android:background="@drawable/neo_card" android:padding="22dp"/>
                <Button android:id="@+id/dndPermission" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="14dp" android:text="ENABLE • Game Mode / DND" android:textColor="@color/gb_text" android:background="@drawable/neo_button"/>
                <TextView android:id="@+id/dndPermissionState" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:text="CHECKING..." android:textColor="@color/gb_muted"/>
                <Button android:id="@+id/usagePermission" android:layout_width="match_parent" android:layout_height="54dp" android:text="ENABLE • Usage Access" android:textColor="@color/gb_text" android:background="@drawable/neo_button"/>
                <TextView android:id="@+id/usagePermissionState" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:text="CHECKING..." android:textColor="@color/gb_muted"/>
                <Button android:id="@+id/overlayPermission" android:layout_width="match_parent" android:layout_height="54dp" android:text="ENABLE • Draw Over Other Apps" android:textColor="@color/gb_text" android:background="@drawable/neo_button"/>
                <TextView android:id="@+id/overlayPermissionState" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:text="CHECKING..." android:textColor="@color/gb_muted"/>
                <Button android:id="@+id/notificationPermission" android:layout_width="match_parent" android:layout_height="54dp" android:text="ENABLE • Notifications" android:textColor="@color/gb_text" android:background="@drawable/neo_button"/>
                <TextView android:id="@+id/notificationPermissionState" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:text="CHECKING..." android:textColor="@color/gb_muted"/>
                <Button android:id="@+id/writeSettingsPermission" android:layout_width="match_parent" android:layout_height="54dp" android:text="ENABLE • System Settings" android:textColor="@color/gb_text" android:background="@drawable/neo_button"/>
                <TextView android:id="@+id/writeSettingsPermissionState" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:text="CHECKING..." android:textColor="@color/gb_muted"/>
            </LinearLayout>
        </ScrollView>

        <ScrollView android:id="@+id/historyPage" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="▥  History" android:textColor="@color/gb_text" android:textSize="25sp" android:textStyle="bold"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                    <TextView android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:text="1D" android:textColor="@color/gb_muted" android:background="@drawable/neo_button"/>
                    <TextView android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:text="1W" android:textColor="@color/gb_muted"/>
                    <TextView android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:text="1M" android:textColor="@color/gb_text" android:background="@drawable/neo_selected"/>
                    <TextView android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:text="3M" android:textColor="@color/gb_muted"/>
                </LinearLayout>
                <com.codleander.gamebooster.HistoryChartView android:id="@+id/historyChart" android:layout_width="match_parent" android:layout_height="220dp" android:layout_marginTop="14dp" android:background="@drawable/neo_card"/>
                <TextView android:id="@+id/historyHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:padding="18dp" android:text="TODAY  0m&#10;THIS MONTH  0m&#10;PEAK THERMAL  N/A" android:textColor="@color/gb_text" android:background="@drawable/neo_card"/>
            </LinearLayout>
        </ScrollView>

        <ScrollView android:id="@+id/aboutPage" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:padding="28dp">
                <ImageView android:layout_width="100dp" android:layout_height="100dp" android:src="@drawable/ic_game_booster" android:contentDescription="Game Booster"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Game Booster" android:textColor="@color/gb_text" android:textSize="28sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Version 2.0.0" android:textColor="@color/gb_muted" android:textSize="15sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="25dp" android:padding="22dp" android:gravity="center" android:text="PLAY BETTER • FASTER • LONGER&#10;&#10;Real device telemetry • Session tracking • Game profiles&#10;&#10;Built for gamers." android:textColor="@color/gb_text" android:textSize="15sp" android:background="@drawable/neo_card"/>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout android:id="@+id/bottomNav" android:layout_width="match_parent" android:layout_height="70dp" android:layout_gravity="bottom" android:orientation="horizontal" android:padding="7dp" android:background="@drawable/neo_card">
        <TextView android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⌂&#10;Home" android:textColor="@color/gb_accent_bright" android:textSize="11sp" android:clickable="true"/>
        <TextView android:id="@+id/navGames" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="🎮&#10;Games" android:textColor="@color/gb_muted" android:textSize="11sp" android:clickable="true"/>
        <TextView android:id="@+id/navHistory" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▥&#10;History" android:textColor="@color/gb_muted" android:textSize="11sp" android:clickable="true"/>
        <TextView android:id="@+id/navSettings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⚙&#10;Settings" android:textColor="@color/gb_muted" android:textSize="11sp" android:clickable="true"/>
    </LinearLayout>
</FrameLayout>