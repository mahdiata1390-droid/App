<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/gb_background">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <ImageView android:id="@+id/lightningIcon" android:layout_width="34dp" android:layout_height="34dp"
                android:src="@drawable/ic_lightning" android:contentDescription="Electric" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="10dp" android:text="GAME BOOSTER" android:textColor="@color/gb_text"
                android:textSize="28sp" android:textStyle="bold" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="ELECTRIC PERFORMANCE CONTROL" android:textColor="@color/gb_accent_bright"
            android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.12" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="18dp">
            <TextView android:id="@+id/ram" android:text="RAM&#10;--" android:textColor="@color/gb_text"
                android:gravity="center" android:background="@drawable/neo_card" android:elevation="8dp"
                android:layout_width="0dp" android:layout_height="92dp" android:layout_weight="1" />
            <TextView android:id="@+id/thermal" android:text="THERMAL&#10;--" android:textColor="@color/gb_text"
                android:gravity="center" android:background="@drawable/neo_card" android:elevation="8dp"
                android:layout_width="0dp" android:layout_height="92dp" android:layout_weight="1" android:layout_marginStart="10dp" />
            <TextView android:id="@+id/refresh" android:text="DISPLAY&#10;--" android:textColor="@color/gb_text"
                android:gravity="center" android:background="@drawable/neo_card" android:elevation="8dp"
                android:layout_width="0dp" android:layout_height="92dp" android:layout_weight="1" android:layout_marginStart="10dp" />
        </LinearLayout>

        <Button android:id="@+id/dnd" android:text="⚡ GAME MODE / DND SETTINGS"
            android:textColor="@color/gb_text" android:textStyle="bold"
            android:background="@drawable/neo_button" android:elevation="10dp"
            android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="18dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="INSTALLED GAMES" android:textColor="@color/gb_text"
            android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="26dp" />
        <LinearLayout android:id="@+id/games" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="10dp" />
    </LinearLayout>
</ScrollView>