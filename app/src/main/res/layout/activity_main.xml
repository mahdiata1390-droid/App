<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/gb_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<ImageView android:id="@+id/lightningIcon" android:layout_width="38dp" android:layout_height="38dp" android:src="@drawable/ic_lightning" android:contentDescription="Electric" />
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="GAME BOOSTER" android:textColor="@color/gb_text" android:textSize="27sp" android:textStyle="bold" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ELECTRIC PERFORMANCE CONTROL" android:textColor="@color/gb_accent_bright" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.10" />
</LinearLayout></LinearLayout>
<TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:padding="14dp" android:gravity="center" android:text="SYSTEM READY • TAP BOOST TO LAUNCH" android:textColor="@color/gb_muted" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/neo_card" android:elevation="5dp" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp">
<TextView android:id="@+id/ram" android:text="RAM&#10;--" android:textColor="@color/gb_text" android:gravity="center" android:background="@drawable/neo_card" android:elevation="8dp" android:layout_width="0dp" android:layout_height="94dp" android:layout_weight="1" />
<TextView android:id="@+id/thermal" android:text="THERMAL&#10;--" android:textColor="@color/gb_text" android:gravity="center" android:background="@drawable/neo_card" android:elevation="8dp" android:layout_width="0dp" android:layout_height="94dp" android:layout_weight="1" android:layout_marginStart="10dp" />
<TextView android:id="@+id/refresh" android:text="DISPLAY&#10;--" android:textColor="@color/gb_text" android:gravity="center" android:background="@drawable/neo_card" android:elevation="8dp" android:layout_width="0dp" android:layout_height="94dp" android:layout_weight="1" android:layout_marginStart="10dp" />
</LinearLayout>
<TextView android:id="@+id/boost" android:layout_width="match_parent" android:layout_height="86dp" android:layout_marginTop="18dp" android:gravity="center" android:text="⚡  BOOST  ⚡&#10;LAUNCH &amp; OPTIMIZE" android:textColor="@color/gb_text" android:textSize="21sp" android:textStyle="bold" android:background="@drawable/neo_boost" android:elevation="12dp" android:clickable="true" android:focusable="true" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="14dp">
<Button android:id="@+id/dnd" android:text="DND / GAME MODE" android:textColor="@color/gb_text" android:textStyle="bold" android:background="@drawable/neo_button" android:elevation="8dp" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" />
<Button android:id="@+id/refreshStats" android:text="↻ REFRESH" android:textColor="@color/gb_accent_bright" android:textStyle="bold" android:background="@drawable/neo_button" android:elevation="8dp" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_marginStart="10dp" />
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MY GAMES" android:textColor="@color/gb_text" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="26dp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Choose a game to start the boost flow" android:textColor="@color/gb_muted" android:textSize="12sp" android:layout_marginTop="3dp" />
<LinearLayout android:id="@+id/games" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="10dp" />
</LinearLayout></ScrollView>