<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="640dp"
        android:layout_gravity="top"
        android:alpha="0.55"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_hero" />

    <View
        android:layout_width="match_parent"
        android:layout_height="640dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_backdrop_scrim"
        android:importantForAccessibility="no" />

    <FrameLayout
        android:id="@+id/pageHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="76dp">

        <include layout="@layout/page_home" android:id="@+id/homePage" />
        <include layout="@layout/page_library" android:id="@+id/gamesPage" />
        <include layout="@layout/page_boosting" android:id="@+id/boostingPage" />
        <include layout="@layout/page_settings" android:id="@+id/settingsPage" />
        <include layout="@layout/page_permissions" android:id="@+id/permissionPage" />
        <include layout="@layout/page_history" android:id="@+id/historyPage" />
        <include layout="@layout/page_about" android:id="@+id/aboutPage" />
    </FrameLayout>

    <include
        layout="@layout/bottom_nav"
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="bottom" />

    <include layout="@layout/splash" android:id="@+id/splashPage" />
</FrameLayout>
