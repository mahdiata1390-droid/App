<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/electric_background"
    android:layoutDirection="ltr">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="84dp">

        <!-- HOME -->
        <ScrollView
            android:id="@+id/homePage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/menuIcon"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:padding="7dp"
                        android:src="@drawable/ic_lightning"
                        android:contentDescription="Game Booster"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Game "
                        android:textColor="@color/gb_text"
                        android:textSize="25sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Booster"
                        android:textColor="@color/gb_accent_bright"
                        android:textSize="25sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/homePremium"
                        android:layout_width="50dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:text="♛"
                        android:textColor="#FFE36B"
                        android:textSize="25sp"
                        android:background="@drawable/neo_icon"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="SYSTEM READY • SELECT A GAME"
                    android:textColor="@color/gb_muted"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/electric_status"/>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginTop="12dp">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/boost_ring"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:layout_width="78dp"
                            android:layout_height="78dp"
                            android:padding="9dp"
                            android:src="@drawable/ic_game_booster"
                            android:contentDescription="Boost"/>
                        <TextView
                            android:id="@+id/boost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Boost"
                            android:textColor="@color/gb_text"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Tap to Boost"
                            android:textColor="@color/gb_accent_bright"
                            android:textSize="14sp"/>
                    </LinearLayout>
                </FrameLayout>

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="2">
                    <TextView
                        android:id="@+id/ram"
                        android:layout_width="0dp"
                        android:layout_height="108dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:gravity="center"
                        android:text="RAM&#10;--"
                        android:textColor="@color/gb_text"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:background="@drawable/neo_card_strong"/>
                    <TextView
                        android:id="@+id/battery"
                        android:layout_width="0dp"
                        android:layout_height="108dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:gravity="center"
                        android:text="BATTERY&#10;--"
                        android:textColor="@color/gb_text"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:background="@drawable/neo_card_strong"/>
                    <TextView
                        android:id="@+id/thermal"
                        android:layout_width="0dp"
                        android:layout_height="108dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:gravity="center"
                        android:text="TEMP&#10;--"
                        android:textColor="@color/gb_text"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:background="@drawable/neo_card_strong"/>
                    <TextView
                        android:id="@+id/networkStatus"
                        android:layout_width="0dp"
                        android:layout_height="108dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:gravity="center"
                        android:text="NETWORK&#10;--"
                        android:textColor="@color/gb_text"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:background="@drawable/neo_card_strong"/>
                </GridLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="82dp"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:id="@+id/pingStatus"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:layout_margin="5dp"
                        android:gravity="center"
                        android:text="PING&#10;--"
                        android:textColor="@color/gb_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/neo_card_strong"/>
                    <TextView
                        android:id="@+id/refresh"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:layout_margin="5dp"
                        android:gravity="center"
                        android:text="DISPLAY&#10;--"
                        android:textColor="@color/gb_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/neo_card_strong"/>
                    <TextView
                        android:id="@+id/sessionTimer"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:layout_margin="5dp"
                        android:gravity="center"
                        android:text="SESSION&#10;00:00:00"
                        android:textColor="@color/gb_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/neo_card_strong"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- GAME LIBRARY -->
        <ScrollView
            android:id="@+id/gamesPage"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/ic_game_booster"
                        android:contentDescription="Games"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="7dp"
                        android:text="Game Library"
                        android:textColor="@color/gb_text"
                        android:textSize="23sp"
                        android:textStyle="bold"/>
                    <Button
                        android:id="@+id/refreshStats"
                        android:layout_width="50dp"
                        android:layout_height="46dp"
                        android:text="⌕"
                        android:textSize="24sp"
                        android:textColor="@color/gb_text"
                        android:background="@drawable/neo_icon"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:gravity="center" android:text="All" android:textColor="@color/gb_text" android:textStyle="bold" android:background="@drawable/neo_selected"/>
                    <TextView android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:gravity="center" android:text="Popular" android:textColor="@color/gb_muted"/>
                    <TextView android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:gravity="center" android:text="Installed" android:textColor="@color/gb_muted"/>
                </LinearLayout>
                <GridLayout
                    android:id="@+id/games"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:layout_marginTop="10dp"/>
            </LinearLayout>
        </ScrollView>

        <!-- BOOSTING -->
        <ScrollView
            android:id="@+id/boostingPage"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:gravity="center_vertical">
                    <Button android:id="@+id/boostBack" android:layout_width="48dp" android:layout_height="46dp" android:text="‹" android:textSize="30sp" android:textColor="@color/gb_text" android:background="@drawable/neo_icon"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Boosting..." android:textColor="@color/gb_text" android:textSize="22sp" android:textStyle="bold"/>
                    <TextView android:layout_width="48dp" android:layout_height="46dp" android:gravity="center" android:text="⚙" android:textColor="@color/gb_text" android:textSize="23sp" android:background="@drawable/neo_icon"/>
                </LinearLayout>
                <FrameLayout android:layout_width="310dp" android:layout_height="310dp" android:layout_marginTop="28dp">
                    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/boost_ring"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                        <ImageView android:layout_width="74dp" android:layout_height="74dp" android:src="@drawable/ic_lightning" android:contentDescription="Boosting"/>
                        <TextView android:id="@+id/boostProgress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="82%" android:textColor="@color/gb_text" android:textSize="38sp" android:textStyle="bold"/>
                    </LinearLayout>
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Optimizing your device..." android:textColor="@color/gb_text" android:textSize="14sp"/>
                <TextView android:id="@+id/boostSteps" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:padding="18dp" android:text="✓  Cleaning background apps...&#10;✓  Freeing up RAM...&#10;✓  Optimizing performance...&#10;✓  Cooling CPU..." android:textColor="@color/gb_text" android:textSize="14sp" android:lineSpacingExtra="7dp" android:background="@drawable/neo_card_strong"/>
                <Button android:id="@+id/endBoost" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="16dp" android:text="END SESSION" android:textColor="@color/gb_text" android:background="@drawable/neo_button"/>
            </LinearLayout>
        </ScrollView>

        <!-- SETTINGS -->
        <ScrollView
            android:id="@+id/settingsPage"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚙  Settings" android:textColor="@color/gb_text" android:textSize="24sp" android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="94dp" android:layout_marginTop="12dp" android:padding="20dp" android:text="🎮   Premium User&#10;      Game Booster                                      ♛" android:textColor="@color/gb_text" android:textSize="16sp" android:textStyle="bold" android:gravity="center_vertical" android:background="@drawable/neo_card_strong"/>
                <Button android:id="@+id/dnd" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="12dp" android:text="◉  Boost Mode   Performance / Balanced / Battery     ›" android:textColor="@color/gb_text" android:gravity="center_vertical" android:background="@drawable/neo_button"/>
                <Button android:id="@+id/appearanceButton" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="9dp" android:text="◐  Appearance   Dark / AMOLED                         ›" android:textColor="@color/gb_text" android:gravity="center_vertical" android:background="@drawable/neo_button"/>
                <Button android:id="@+id/languageButton" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="9dp" android:text="◎  Language   English / فارسی                              ›" android:textColor="@color/gb_text" android:gravity="center_vertical" android:background="@drawable/neo_button"/>
                <Button android:id="@+id/permissionButton" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="9dp" android:text="◈  Permission Center                                    ›" android:textColor="@color/gb_accent_bright" android:gravity="center_vertical" android:background="@drawable/neo_button"/>
            </LinearLayout>
        </ScrollView>

        <!-- PERMISSIONS -->
        <ScrollView
            android:id="@+id/permissionPage"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="58dp" android:gravity="center" android:text="‹   Permission Center" android:textColor="@color/gb_text" android:textSize="23sp" android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="170dp" android:layout_marginTop="8dp" android:gravity="center" android:text="✓&#10;&#10;All Permissions Granted&#10;Your device is fully optimized!" android:textColor="@color/gb_text" android:textSize="16sp" android:textStyle="bold" android:background="@drawable/neo_card_strong"/>
                <Button android:id="@+id/dndPermission" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:text="ENABLE • Game Mode / DND" android:textColor="@color/gb_text" android:background="@drawable/neo_button"/>
                <TextView android:id="@+id/dndPermissionState" android:layout_width="match_parent" android:layout_height="26dp" android:paddingStart="10dp" android:text="CHECKING..." android:textColor="@color/gb_muted"/>
                <Button android:id="@+id/usagePermission" android:layout_width="match_parent" android:layout_height="52dp" android:text="ENABLE • Usage Access" android:textColor="@color/gb_text" android:background="@drawable/neo_button"/>
                <TextView android:id="@+id/usagePermissionState" android:layout_width="match_parent" android:layout_height="26dp" android:paddingStart="10dp" android:text="CHECKING..." android:textColor="@color/gb_muted"/>
                <Button android:id="@+id/overlayPermission" android:layout_width="match_parent" android:layout_height="52dp" android:text="ENABLE • Draw Over Other Apps" android:textColor="@color/gb_text" android:background="@drawable/neo_button"/>
                <TextView android:id="@+id/overlayPermissionState" android:layout_width="match_parent" android:layout_height="26dp" android:paddingStart="10dp" android:text="CHECKING..." android:textColor="@color/gb_muted"/>
                <Button android:id="@+id/notificationPermission" android:layout_width="match_parent" android:layout_height="52dp" android:text="ENABLE • Notifications" android:textColor="@color/gb_text" android:background="@drawable/neo_button"/>
                <TextView android:id="@+id/notificationPermissionState" android:layout_width="match_parent" android:layout_height="26dp" android:paddingStart="10dp" android:text="CHECKING..." android:textColor="@color/gb_muted"/>
                <Button android:id="@+id/writeSettingsPermission" android:layout_width="match_parent" android:layout_height="52dp" android:text="ENABLE • System Settings" android:textColor="@color/gb_text" android:background="@drawable/neo_button"/>
                <TextView android:id="@+id/writeSettingsPermissionState" android:layout_width="match_parent" android:layout_height="26dp" android:paddingStart="10dp" android:text="CHECKING..." android:textColor="@color/gb_muted"/>
            </LinearLayout>
        </ScrollView>

        <!-- HISTORY -->
        <ScrollView
            android:id="@+id/historyPage"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="58dp" android:gravity="center_vertical" android:text="▥  History" android:textColor="@color/gb_text" android:textSize="24sp" android:textStyle="bold"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="46dp">
                    <TextView android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:text="1D" android:textColor="@color/gb_muted" android:background="@drawable/neo_button"/>
                    <TextView android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:text="1W" android:textColor="@color/gb_muted"/>
                    <TextView android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:text="1M" android:textColor="@color/gb_text" android:background="@drawable/neo_selected"/>
                    <TextView android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:text="3M" android:textColor="@color/gb_muted"/>
                </LinearLayout>
                <com.codleander.gamebooster.HistoryChartView android:id="@+id/historyChart" android:layout_width="match_parent" android:layout_height="230dp" android:layout_marginTop="10dp" android:background="@drawable/neo_card_strong"/>
                <TextView android:id="@+id/historyHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:padding="18dp" android:text="Total Boosts   0&#10;Avg. Gain   --&#10;Play Time   0h&#10;&#10;Recent Activity" android:textColor="@color/gb_text" android:textSize="15sp" android:background="@drawable/neo_card_strong"/>
            </LinearLayout>
        </ScrollView>

        <!-- ABOUT -->
        <ScrollView
            android:id="@+id/aboutPage"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:padding="20dp">
                <ImageView android:layout_width="112dp" android:layout_height="112dp" android:src="@drawable/ic_game_booster" android:contentDescription="Game Booster"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Game Booster" android:textColor="@color/gb_text" android:textSize="27sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Version 2.0.0" android:textColor="@color/gb_muted" android:textSize="15sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:padding="22dp" android:gravity="center" android:text="Play Better • Faster • Longer&#10;&#10;✓ Optimized Performance&#10;✓ Premium Features&#10;✓ No Ads&#10;✓ Made for Gamers ❤️&#10;&#10;© 2026 Game Booster" android:textColor="@color/gb_text" android:textSize="15sp" android:lineSpacingExtra="6dp" android:background="@drawable/neo_card_strong"/>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:padding="7dp"
        android:background="@drawable/neo_card_strong">
        <TextView android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⌂&#10;Home" android:textColor="@color/gb_accent_bright" android:textSize="11sp" android:textStyle="bold" android:clickable="true"/>
        <TextView android:id="@+id/navGames" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="🎮&#10;Games" android:textColor="@color/gb_muted" android:textSize="11sp" android:clickable="true"/>
        <TextView android:id="@+id/navHistory" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▥&#10;History" android:textColor="@color/gb_muted" android:textSize="11sp" android:clickable="true"/>
        <TextView android:id="@+id/navSettings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⚙&#10;Settings" android:textColor="@color/gb_muted" android:textSize="11sp" android:clickable="true"/>
    </LinearLayout>

    <!-- SPLASH -->
    <FrameLayout
        android:id="@+id/splashPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/electric_background"
        android:elevation="30dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="150dp" android:layout_height="150dp" android:src="@drawable/ic_game_booster" android:contentDescription="Game Booster"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="GAME" android:textColor="@color/gb_text" android:textSize="38sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BOOSTER" android:textColor="@color/gb_accent_bright" android:textSize="42sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Play Better • Faster • Longer" android:textColor="@color/gb_text" android:textSize="14sp"/>
            <ProgressBar android:layout_width="240dp" android:layout_height="8dp" android:layout_marginTop="26dp" android:indeterminate="false" android:progress="70" android:max="100" android:progressTint="@color/gb_accent"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Loading..." android:textColor="@color/gb_muted" android:textSize="11sp"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>