<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/boostingPage"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="10dp"
    android:paddingEnd="18dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/boostBack"
            style="@style/GbIconButton"
            android:contentDescription="@string/cancel"
            android:src="@drawable/ic_back"
            android:tint="@color/gb_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/boosting_title"
            android:textColor="@color/gb_text"
            android:textSize="19sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/boostSettings"
            style="@style/GbIconButton"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings"
            android:tint="@color/gb_text" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="270dp"
                    android:layout_height="270dp"
                    android:layout_marginTop="10dp">

                    <com.codleander.gamebooster.BoostRingView
                        android:id="@+id/boostRing"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="96dp"
                            android:layout_height="96dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_glow" />

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/boost"
                                android:padding="18dp"
                                android:src="@drawable/ic_rocket"
                                android:tint="?attr/gbAccentBright" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/boostPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/boost_zero"
                            android:textColor="@color/gb_text"
                            android:textSize="38sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/boostStage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/optimizing_device"
                    android:textColor="?attr/gbAccentSoft"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/boostSteps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:id="@+id/boostStepRow1"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/boostStepDot1"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_step_circle">

                            <ImageView
                                android:id="@+id/boostStepIcon1"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:padding="6dp"
                                android:src="@drawable/ic_check"
                                android:tint="@color/gb_step_pending" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/boostStepText1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/step_clean"
                            android:textColor="@color/gb_text"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/boostStepRow2"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/boostStepDot2"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_step_circle">

                            <ImageView
                                android:id="@+id/boostStepIcon2"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:padding="6dp"
                                android:src="@drawable/ic_check"
                                android:tint="@color/gb_step_pending" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/boostStepText2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/step_ram"
                            android:textColor="@color/gb_text"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/boostStepRow3"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/boostStepDot3"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_step_circle">

                            <ImageView
                                android:id="@+id/boostStepIcon3"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:padding="6dp"
                                android:src="@drawable/ic_check"
                                android:tint="@color/gb_step_pending" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/boostStepText3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/step_optimize"
                            android:textColor="@color/gb_text"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/boostStepRow4"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/boostStepDot4"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_step_circle">

                            <ImageView
                                android:id="@+id/boostStepIcon4"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:padding="6dp"
                                android:src="@drawable/ic_check"
                                android:tint="@color/gb_step_pending" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/boostStepText4"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/step_cool"
                            android:textColor="@color/gb_text"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/boostCancel"
                    style="@style/GbGhostButton"
                    android:layout_width="match_parent"
                    android:layout_marginTop="14dp"
                    android:text="@string/cancel" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
