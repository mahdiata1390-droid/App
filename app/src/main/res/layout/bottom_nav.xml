<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNav"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:background="@drawable/bg_nav"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/navHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/navHomeIcon"
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:contentDescription="@string/nav_home"
            android:src="@drawable/ic_home"
            android:tint="?attr/gbAccentBright" />

        <TextView
            android:id="@+id/navHomeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_home"
            android:textColor="?attr/gbAccentBright"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navGames"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/navGamesIcon"
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:contentDescription="@string/nav_games"
            android:src="@drawable/ic_gamepad"
            android:tint="@color/gb_muted" />

        <TextView
            android:id="@+id/navGamesLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_games"
            android:textColor="@color/gb_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navHistory"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/navHistoryIcon"
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:contentDescription="@string/nav_history"
            android:src="@drawable/ic_history"
            android:tint="@color/gb_muted" />

        <TextView
            android:id="@+id/navHistoryLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_history"
            android:textColor="@color/gb_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navSettings"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/navSettingsIcon"
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:contentDescription="@string/nav_settings"
            android:src="@drawable/ic_settings"
            android:tint="@color/gb_muted" />

        <TextView
            android:id="@+id/navSettingsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_settings"
            android:textColor="@color/gb_muted"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
