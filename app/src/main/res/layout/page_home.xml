<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homePage"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/menuButton"
                style="@style/GbIconButton"
                android:contentDescription="@string/settings"
                android:src="@drawable/ic_menu"
                android:tint="@color/gb_text" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/gb_text"
                android:textSize="21sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/crownButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/about"
                android:padding="7dp"
                android:src="@drawable/ic_crown"
                android:tint="@color/gb_gold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeGameChip"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_card_soft"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/homeGameIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/game_library" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/homeGameName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/home_no_game"
                    android:textColor="@color/gb_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/homeGameState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_no_game_sub"
                    android:textColor="@color/gb_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/homeLibrary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:text="@string/home_library"
                android:textColor="@color/gb_accent_bright"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="292dp"
            android:layout_marginTop="4dp">

            <com.codleander.gamebooster.BoostRingView
                android:id="@+id/homeRing"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/homeBoostButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="118dp"
                    android:layout_height="118dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_glow" />

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/boost"
                        android:padding="20dp"
                        android:src="@drawable/ic_gamepad"
                        android:tint="@color/gb_accent_bright" />
                </FrameLayout>

                <TextView
                    android:id="@+id/homeBoostTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/boost"
                    android:textColor="@color/gb_text"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/homeBoostHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/tap_to_boost"
                    android:textColor="@color/gb_accent_bright"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>

        <Button
            android:id="@+id/stopBoostButton"
            style="@style/GbGhostButton"
            android:layout_width="match_parent"
            android:layout_marginTop="2dp"
            android:text="@string/stop_boost"
            android:visibility="gone" />

        <TextView
            style="@style/GbSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/quick_actions" />

        <LinearLayout
            android:id="@+id/homeQuickActions"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/qaDnd"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_soft"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_bell"
                    android:tint="@color/gb_accent_bright" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/qa_dnd"
                    android:textColor="@color/gb_text"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/qaDndState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dnd_off"
                    android:textColor="@color/gb_muted"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/qaFps"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_soft"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_speed"
                    android:tint="@color/gb_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/qa_fps"
                    android:textColor="@color/gb_text"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/qaFpsState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/qa_off"
                    android:textColor="@color/gb_muted"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/qaRam"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_card_soft"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ram"
                    android:tint="@color/gb_gold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/qa_ram"
                    android:textColor="@color/gb_text"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/qaRamState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/qa_ram_sub"
                    android:textColor="@color/gb_muted"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:columnCount="2"
            android:rowCount="2">

            <LinearLayout
                style="@style/GbCard"
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="@drawable/bg_card_soft"
                android:orientation="vertical"
                android:padding="13dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_ram"
                        android:tint="@color/gb_accent_bright" />

                    <TextView
                        style="@style/GbLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="@string/stat_ram" />
                </LinearLayout>

                <TextView
                    android:id="@+id/statRamValue"
                    style="@style/GbValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/dash"
                    android:textSize="21sp" />

                <TextView
                    android:id="@+id/statRamSub"
                    style="@style/GbSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dash" />

                <ProgressBar
                    android:id="@+id/statRamBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/bg_stat_bar" />
            </LinearLayout>

            <LinearLayout
                style="@style/GbCard"
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="@drawable/bg_card_soft"
                android:orientation="vertical"
                android:padding="13dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_battery"
                        android:tint="@color/gb_green" />

                    <TextView
                        style="@style/GbLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="@string/stat_battery" />
                </LinearLayout>

                <TextView
                    android:id="@+id/statBatteryValue"
                    style="@style/GbValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/dash"
                    android:textSize="21sp" />

                <TextView
                    android:id="@+id/statBatterySub"
                    style="@style/GbSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dash" />

                <ProgressBar
                    android:id="@+id/statBatteryBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/bg_stat_bar" />
            </LinearLayout>

            <LinearLayout
                style="@style/GbCard"
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="@drawable/bg_card_soft"
                android:orientation="vertical"
                android:padding="13dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_temp"
                        android:tint="@color/gb_red" />

                    <TextView
                        style="@style/GbLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="@string/stat_temp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/statTempValue"
                    style="@style/GbValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/dash"
                    android:textSize="21sp" />

                <TextView
                    android:id="@+id/statTempSub"
                    style="@style/GbSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/thermal_normal" />

                <ProgressBar
                    android:id="@+id/statTempBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/bg_stat_bar" />
            </LinearLayout>

            <LinearLayout
                style="@style/GbCard"
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="@drawable/bg_card_soft"
                android:orientation="vertical"
                android:padding="13dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_network"
                        android:tint="@color/gb_accent_bright" />

                    <TextView
                        style="@style/GbLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="@string/stat_network" />
                </LinearLayout>

                <TextView
                    android:id="@+id/statNetworkValue"
                    style="@style/GbValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/dash"
                    android:textSize="21sp" />

                <TextView
                    android:id="@+id/statNetworkSub"
                    style="@style/GbSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dash" />

                <ProgressBar
                    android:id="@+id/statNetworkBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:max="200"
                    android:progress="0"
                    android:progressDrawable="@drawable/bg_stat_bar" />
            </LinearLayout>
        </GridLayout>

        <TextView
            android:id="@+id/homeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/status_ready"
            android:textColor="@color/gb_muted"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
