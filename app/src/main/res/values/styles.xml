<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.GameBooster" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Vazirmatn (SIL OFL) covers Latin and Persian, so both languages share one face. -->
        <item name="android:fontFamily">@font/vazirmatn_regular</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/gb_background</item>
        <item name="android:navigationBarColor">@color/gb_background</item>
        <item name="android:colorAccent">@color/gb_accent</item>
        <item name="android:windowBackground">@color/gb_background</item>
        <item name="android:textColorPrimary">@color/gb_text</item>
        <item name="android:textColorSecondary">@color/gb_muted</item>
        <item name="materialButtonStyle">@style/GbPrimaryButton</item>
        <item name="gbAccent">@color/gb_accent</item>
        <item name="gbAccentBright">@color/gb_accent_bright</item>
        <item name="gbAccentSoft">@color/gb_accent_soft</item>
        <item name="gbAurora1">#59D8FF</item>
        <item name="gbAurora2">#2F8BFF</item>
    </style>

    <style name="Theme.GameBooster.Violet" parent="Theme.GameBooster">
        <item name="gbAccent">#A85CFF</item>
        <item name="gbAccentBright">#D9A6FF</item>
        <item name="gbAccentSoft">#E7CEFF</item>
        <item name="gbAurora1">#C77DFF</item>
        <item name="gbAurora2">#6B2BFF</item>
        <item name="android:colorAccent">#A85CFF</item>
    </style>

    <style name="Theme.GameBooster.Emerald" parent="Theme.GameBooster">
        <item name="gbAccent">#12C97B</item>
        <item name="gbAccentBright">#5CFFC0</item>
        <item name="gbAccentSoft">#A6FFDC</item>
        <item name="gbAurora1">#5CFFC0</item>
        <item name="gbAurora2">#0E8F5B</item>
        <item name="android:colorAccent">#12C97B</item>
    </style>

    <style name="Theme.GameBooster.Ember" parent="Theme.GameBooster">
        <item name="gbAccent">#FF7A3D</item>
        <item name="gbAccentBright">#FFB36B</item>
        <item name="gbAccentSoft">#FFD4AC</item>
        <item name="gbAurora1">#FFB36B</item>
        <item name="gbAurora2">#FF4D2E</item>
        <item name="android:colorAccent">#FF7A3D</item>
    </style>

    <style name="GbTitle">
        <item name="android:textColor">@color/gb_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/vazirmatn_medium</item>
    </style>

    <style name="GbSectionTitle">
        <item name="android:textColor">?attr/gbAccentBright</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="GbLabel">
        <item name="android:textColor">@color/gb_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="GbValue">
        <item name="android:textColor">@color/gb_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/vazirmatn_medium</item>
    </style>

    <style name="GbSub">
        <item name="android:textColor">@color/gb_muted</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="GbCard">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>

    <style name="GbRowTitle">
        <item name="android:textColor">@color/gb_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="GbRowSub">
        <item name="android:textColor">@color/gb_muted</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="GbPrimaryButton">
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="GbGhostButton">
        <item name="android:layout_height">50dp</item>
        <item name="android:background">@drawable/bg_ghost_button</item>
        <item name="android:textColor">@color/gb_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="GbIconButton">
        <item name="android:layout_width">42dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">@drawable/bg_icon_circle</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
</resources>
